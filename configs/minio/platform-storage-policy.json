{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::dipole-files",
        "arn:aws:s3:::dipole-files/*",
        "arn:aws:s3:::dipole-search-archives",
        "arn:aws:s3:::dipole-search-archives/*",
        "arn:aws:s3:::dipole-message-archives",
        "arn:aws:s3:::dipole-message-archives/*"
      ]
    }
  ]
}
