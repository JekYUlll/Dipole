{
  "name": "dipole-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent-experience",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc && vite build",
    "test": "vitest run",
    "test:toolchain": "node --test toolchain.test.mjs",
    "test:design": "node --test ../scripts/check-pencil-design.test.mjs && node ../scripts/check-pencil-design.mjs ../design/dipole-ui.pen",
    "test:brand": "node ../scripts/generate-brand-assets.mjs --check",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.0",
    "axios": "^1.7.2",
    "pinia": "^2.1.7",
    "primevue": "^5.0.1",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.0.21"
  }
}
