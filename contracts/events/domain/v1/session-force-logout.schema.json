{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.dev/contracts/events/domain/v1/session-force-logout.schema.json",
  "title": "Dipole Session Force Logout v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["event_id", "event_type", "version", "source", "occurred_at", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "const": "session.force_logout"},
    "version": {"type": "string", "pattern": "^v1(?:\\.[0-9]+)*$"},
    "source": {"type": "string", "const": "dipole"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/session_payload"}
  },
  "$defs": {
    "session_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["user_uuid", "all", "reason", "occurred_at"],
      "properties": {
        "user_uuid": {"type": "string", "minLength": 1},
        "connection_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "all": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
