{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-memory-prefilter/v1/evidence.schema.json",
  "title": "Dipole Agent Memory Prefilter Evidence v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "corpusSha256", "candidate", "decisions"],
  "properties": {
    "schemaVersion": {"const": "dipole.agent.memory-prefilter-evidence.v1"},
    "corpusSha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "revision", "configurationSha256", "decisionThresholdBps"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["embedding", "small_model"]}, "revision": {"$ref": "#/$defs/revision"}, "configurationSha256": {"$ref": "#/$defs/sha256"}, "decisionThresholdBps": {"type": "integer", "minimum": 0, "maximum": 10000}
    }},
    "decisions": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"type": "object", "additionalProperties": false, "required": ["caseId", "selected", "scoreBps", "latencyMicros", "costMicrousd"], "properties": {
      "caseId": {"$ref": "#/$defs/id"}, "selected": {"type": "boolean"}, "scoreBps": {"type": "integer", "minimum": 0, "maximum": 10000}, "latencyMicros": {"type": "integer", "minimum": 0, "maximum": 60000000}, "costMicrousd": {"type": "integer", "minimum": 0, "maximum": 1000000000}
    }}}
  },
  "$defs": {"id": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$"}, "revision": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
