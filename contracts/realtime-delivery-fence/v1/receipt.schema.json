{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/realtime-delivery-fence/v1/receipt.schema.json",
  "title": "Dipole Realtime Delivery Fence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transition_id", "request_sha256", "action", "operator_id",
    "reason_sha256", "previous_sha256", "next_sha256", "authority", "phase",
    "epoch", "lease_until_unix_ms", "applied_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "dipole.realtime.delivery-fence-receipt.v1" },
    "transition_id": { "$ref": "#/$defs/id" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "action": { "enum": ["bootstrap", "freeze", "activate", "renew"] },
    "operator_id": { "$ref": "#/$defs/id" },
    "reason_sha256": { "$ref": "#/$defs/sha256" },
    "previous_sha256": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/sha256" }] },
    "next_sha256": { "$ref": "#/$defs/sha256" },
    "authority": { "enum": ["go", "shadow", "cpp"] },
    "phase": { "enum": ["active", "frozen"] },
    "epoch": { "type": "integer", "minimum": 1 },
    "lease_until_unix_ms": { "type": "integer", "minimum": 1 },
    "applied_at_unix_ms": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
