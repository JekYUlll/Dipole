{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/realtime-delivery-fence/v1/attempt-event.schema.json",
  "title": "Dipole Realtime Delivery Cutover Attempt Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt_id", "sequence", "event_type",
    "previous_event_sha256", "artifact_sha256", "recorded_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "dipole.realtime.cutover-attempt-event.v1" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "source_checkpointed", "freeze_applied", "frozen_confirmed",
        "target_activated", "target_checkpointed", "completed",
        "rollback_requested", "rollback_freeze_applied",
        "rollback_frozen_confirmed", "source_reactivated",
        "rollback_checkpointed", "rolled_back"
      ]
    },
    "previous_event_sha256": { "$ref": "#/$defs/sha256" },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "recorded_at_unix_ms": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
