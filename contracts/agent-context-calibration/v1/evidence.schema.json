{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-context-calibration/v1/evidence.schema.json",
  "title": "Dipole Agent Context Calibration Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "candidate", "capturedAt", "dataClassification", "routes", "profiles", "cases"],
  "properties": {
    "version": { "const": "dipole.agent.context-calibration.evidence.v1" },
    "candidate": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "dataClassification": { "const": "synthetic" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "contextWindowTokens", "utf8BytesPerToken", "safetyMarginBps"],
      "properties": {
        "route": { "type": "string", "minLength": 1 },
        "contextWindowTokens": { "type": "integer", "minimum": 1024, "maximum": 10000000 },
        "utf8BytesPerToken": { "type": "number", "minimum": 1, "maximum": 16 },
        "safetyMarginBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "model", "revision"],
      "properties": {
        "kind": { "enum": ["provider_tokenizer", "provider_usage"] },
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 255 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "category", "text", "referenceTokens", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "route": { "type": "string", "minLength": 1, "maxLength": 255 },
        "category": { "enum": ["chinese", "code", "emoji", "english", "tool_schema"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "referenceTokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
