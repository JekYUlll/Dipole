{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-external-mcp/v1/credential-catalog.schema.json",
  "title": "Dipole Agent External MCP Credential Catalog v1",
  "description": "Lifecycle metadata and opaque external provider references. Secret values are prohibited.",
  "type": "object",
  "x-dipole-version": "dipole.agent.external-mcp-credential-catalog.v1",
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "dipole.agent.external-mcp-credential-catalog.v1"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["tenant_id", "credential_ref", "version", "provider_id", "provider_secret_ref", "status", "valid_from", "expires_at", "revoked_at"],
        "properties": {
          "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
          "credential_ref": {"type": "string", "pattern": "^CRED-[A-Z0-9]{16,64}$"},
          "version": {"type": "integer", "minimum": 1},
          "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
          "provider_secret_ref": {"type": "string", "pattern": "^SECRET-[A-Z0-9]{16,64}$"},
          "status": {"enum": ["active", "revoked"]},
          "valid_from": {"type": "string", "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "revoked_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "active"}}}, "then": {"properties": {"revoked_at": {"type": "null"}}}},
          {"if": {"properties": {"status": {"const": "revoked"}}}, "then": {"properties": {"revoked_at": {"type": "string", "format": "date-time"}}}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
