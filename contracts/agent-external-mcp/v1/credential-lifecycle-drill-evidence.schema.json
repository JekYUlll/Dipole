{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-external-mcp/v1/credential-lifecycle-drill-evidence.schema.json",
  "title": "Dipole Agent External MCP Credential Lifecycle Drill Evidence v1",
  "description": "Low-sensitivity, expiring evidence for an isolated encrypted credential rotation and revocation drill.",
  "type": "object",
  "x-dipole-version": "dipole.agent.external-mcp-credential-lifecycle-drill.v1",
  "required": [
    "schema_version",
    "outcome",
    "isolation",
    "collected_at",
    "expires_at",
    "initial_credential_verified",
    "rotated_credential_verified",
    "old_version_revoked_before_transport",
    "restart_recovered",
    "active_version_revoked_before_transport",
    "transport_open_count",
    "transport_close_count",
    "inflight_revocation_authority",
    "production_authority",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "dipole.agent.external-mcp-credential-lifecycle-drill.v1"},
    "outcome": {"const": "passed"},
    "isolation": {"const": "disposable_encrypted_files_and_injected_transport"},
    "collected_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "initial_credential_verified": {"const": true},
    "rotated_credential_verified": {"const": true},
    "old_version_revoked_before_transport": {"const": true},
    "restart_recovered": {"const": true},
    "active_version_revoked_before_transport": {"const": true},
    "transport_open_count": {"const": 3},
    "transport_close_count": {"const": 3},
    "inflight_revocation_authority": {"const": false},
    "production_authority": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
