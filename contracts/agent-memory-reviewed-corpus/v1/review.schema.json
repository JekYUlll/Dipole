{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-memory-reviewed-corpus/v1/review.schema.json",
  "title": "Dipole Agent Memory Reviewed Corpus Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusSha256", "minimumAgreementBps", "reviews"],
  "properties": {
    "schemaVersion": { "const": "dipole.agent.memory-reviewed-corpus-review.v1" },
    "corpusSha256": { "$ref": "#/$defs/sha256" },
    "minimumAgreementBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "reviews": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/review" } },
    "adjudication": { "$ref": "#/$defs/adjudication" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "label": { "type": "object", "additionalProperties": false, "required": ["caseId", "promotable"], "properties": { "caseId": { "$ref": "#/$defs/id" }, "promotable": { "type": "boolean" } } },
    "labels": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/label" } },
    "review": { "type": "object", "additionalProperties": false, "required": ["reviewId", "reviewerId", "labels"], "properties": { "reviewId": { "$ref": "#/$defs/id" }, "reviewerId": { "$ref": "#/$defs/id" }, "labels": { "$ref": "#/$defs/labels" } } },
    "adjudication": { "type": "object", "additionalProperties": false, "required": ["reviewId", "adjudicatorId", "labels"], "properties": { "reviewId": { "$ref": "#/$defs/id" }, "adjudicatorId": { "$ref": "#/$defs/id" }, "labels": { "$ref": "#/$defs/labels" } } }
  }
}
