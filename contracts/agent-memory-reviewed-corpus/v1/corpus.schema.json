{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-memory-reviewed-corpus/v1/corpus.schema.json",
  "title": "Dipole Agent Memory Reviewed Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "cases", "sha256"],
  "properties": {
    "schemaVersion": { "const": "dipole.agent.memory-reviewed-corpus.v1" },
    "corpusId": { "$ref": "#/$defs/id" },
    "sha256": { "$ref": "#/$defs/sha256" },
    "cases": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "candidateType", "resourceType", "evidenceCount", "contentSha256", "goldPromotable"],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "candidateType": { "enum": ["message", "reflection"] },
        "resourceType": { "$ref": "#/$defs/id" },
        "evidenceCount": { "type": "integer", "minimum": 1, "maximum": 128 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "goldPromotable": { "type": "boolean" }
      }
    }
  }
}
