{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-promotion/v2/publication.schema.json",
  "title": "Dipole Agent promotion evidence publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "taskId", "runId", "runtimeId", "definitionId", "definitionVersion", "evidence"],
  "properties": {
    "schemaVersion": { "const": "dipole.agent.promotion-evidence-publication.v1" },
    "tenantId": { "$ref": "#/$defs/id" },
    "taskId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "runtimeId": { "const": "dipole-agent" },
    "definitionId": { "$ref": "#/$defs/id" },
    "definitionVersion": { "type": "integer", "minimum": 1 },
    "requestId": { "$ref": "#/$defs/id" },
    "traceId": { "$ref": "#/$defs/id" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "candidateVersion", "windowStartedAt", "windowEndedAt", "observations", "projectionEvals", "offlineEvalReport"],
      "properties": {
        "schemaVersion": { "const": "dipole.agent.shadow-promotion-evidence.v2" },
        "candidateVersion": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
        "windowStartedAt": { "type": "string", "format": "date-time" },
        "windowEndedAt": { "type": "string", "format": "date-time" },
        "observations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "projectionEvals": {
          "type": "object", "additionalProperties": false, "required": ["passed", "total"],
          "properties": { "passed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } }
        },
        "offlineEvalReport": { "$ref": "../../agent-evals/v1/offline-report.schema.json" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
