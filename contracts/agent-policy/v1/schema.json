{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-policy/v1/schema.json",
  "title": "Dipole Agent Policy Persistence v1",
  "description": "Language-neutral persisted grant, task snapshot, and replay-safe approval records.",
  "x-dipole-version": "dipole.agent.policy.persistence.v1",
  "oneOf": [
    {"$ref": "#/$defs/definition_version"},
    {"$ref": "#/$defs/task"},
    {"$ref": "#/$defs/approval"}
  ],
  "$defs": {
    "resource_scope": {
      "type": "object",
      "required": ["resource_type", "resource_id", "actions"],
      "properties": {
        "resource_type": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "definition_version": {
      "type": "object",
      "required": ["definition_uuid", "version", "tenant_id", "owner_uuid", "agent_uuid", "status", "permissions", "scopes", "valid_from"],
      "properties": {
        "definition_uuid": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "integer", "minimum": 1},
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "owner_uuid": {"type": "string", "minLength": 1, "maxLength": 24},
        "agent_uuid": {"type": "string", "minLength": 1, "maxLength": 24},
        "status": {"enum": ["active", "revoked"]},
        "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "scopes": {"type": "array", "items": {"$ref": "#/$defs/resource_scope"}},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["task_uuid", "definition_uuid", "definition_version", "tenant_id", "principal_uuid", "agent_uuid", "status", "trigger_type", "trigger_ref", "goal"],
      "properties": {
        "task_uuid": {"type": "string", "minLength": 1, "maxLength": 64},
        "definition_uuid": {"type": "string", "minLength": 1, "maxLength": 64},
        "definition_version": {"type": "integer", "minimum": 1},
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "principal_uuid": {"type": "string", "minLength": 1, "maxLength": 24},
        "agent_uuid": {"type": "string", "minLength": 1, "maxLength": 24},
        "status": {"enum": ["created", "running", "waiting_approval", "completed", "failed", "cancelled"]},
        "trigger_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "trigger_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "goal": {"type": "string"}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["approval_uuid", "task_uuid", "capability_id", "resource_scope", "scope_sha256", "arguments_sha256", "nonce_sha256", "status", "expires_at"],
      "properties": {
        "approval_uuid": {"type": "string", "minLength": 1, "maxLength": 64},
        "task_uuid": {"type": "string", "minLength": 1, "maxLength": 64},
        "capability_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource_scope": {"$ref": "#/$defs/resource_scope"},
        "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "arguments_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["pending", "approved", "consumed", "revoked"]},
        "approved_by_uuid": {"type": "string", "maxLength": 24},
        "expires_at": {"type": "string", "format": "date-time"},
        "consumed_at": {"type": ["string", "null"], "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
