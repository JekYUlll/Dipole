{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-subscription-prefilter/v1/corpus.schema.json",
  "title": "Dipole Agent Subscription Prefilter Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "revision", "thresholds", "cases"],
  "properties": {
    "schemaVersion": {"const": "dipole.agent.subscription-prefilter-corpus.v1"},
    "corpusId": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/revision"},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumPrecisionBps", "minimumRecallBps", "maximumP95LatencyMicros", "maximumMeanCostMicrousd"],
      "properties": {
        "minimumPrecisionBps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimumRecallBps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "maximumP95LatencyMicros": {"type": "integer", "minimum": 1, "maximum": 60000000},
        "maximumMeanCostMicrousd": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    },
    "cases": {
      "type": "array", "minItems": 2, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "expectedRelevant", "event"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "expectedRelevant": {"type": "boolean"},
          "event": {
            "type": "object", "additionalProperties": false,
            "required": ["eventId", "eventType", "aggregateId", "occurredAt", "payload"],
            "properties": {
              "eventId": {"type": "string", "minLength": 1, "maxLength": 128},
              "eventType": {"type": "string", "minLength": 1, "maxLength": 64},
              "aggregateId": {"type": "string", "minLength": 1, "maxLength": 128},
              "occurredAt": {"type": "string", "format": "date-time"},
              "payload": {
                "type": "object", "additionalProperties": false,
                "required": ["conversation_key", "content"],
                "properties": {
                  "conversation_key": {"type": "string", "minLength": 1, "maxLength": 128},
                  "content": {"type": "string", "maxLength": 8192}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "revision": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"}
  }
}
