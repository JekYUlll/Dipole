{
  "schemaVersion": "dipole.agent.memory-retention-policy.v1",
  "policyVersion": "memory-retention-v1",
  "contentErasureScope": "memory_root",
  "tombstone": "[erased]",
  "erasedFields": ["compact_content", "content", "correction_reason", "original_source_identity", "resource_binding", "revoke_reason", "source_uri"],
  "retainedFields": ["agent_uuid", "content_erased_at", "content_erased_by_uuid", "content_erasure_reason_code", "memory_root_uuid", "memory_uuid", "memory_version", "principal_uuid", "supersedes_memory_uuid", "tenant_id"],
  "reasonCodes": ["owner_request", "policy_violation", "retention_expired"],
  "automaticExecutionAuthority": false,
  "publicApiAuthority": false
}
