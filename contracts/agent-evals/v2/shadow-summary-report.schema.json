{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dipole Agent Shadow Evaluation Summary Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "candidateVersion", "summary", "evaluationSuiteSha256", "limitations"],
  "properties": {
    "schemaVersion": {"const": "dipole.agent.shadow-eval-summary-report.v2"},
    "source": {"$ref": "../../v1/shadow-summary-input.schema.json#/properties/source"},
    "candidateVersion": {"type": "string", "minLength": 2, "maxLength": 128},
    "summary": {"type": "object"},
    "evaluationSuiteSha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
