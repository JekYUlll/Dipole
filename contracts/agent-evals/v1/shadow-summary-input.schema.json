{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-evals/v1/shadow-summary-input.schema.json",
  "title": "Dipole Agent Shadow Evaluation Summary Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "reports"],
  "properties": {
    "schemaVersion": {"const": "dipole.agent.shadow-eval-summary-input.v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "environment", "runtimeRevision", "windowStart", "windowEnd"],
      "properties": {
        "kind": {"const": "reviewed_shadow"},
        "environment": {"enum": ["isolated", "shared_development"]},
        "runtimeRevision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "windowStart": {"type": "string", "format": "date-time"},
        "windowEnd": {"type": "string", "format": "date-time"}
      }
    },
    "reports": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "offline-report.schema.json"}}
  }
}
