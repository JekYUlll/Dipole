{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-evals/v1/memory-correction-manifest.schema.json",
  "title": "Dipole Agent Memory Correction Evaluation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateVersion", "expectedSourceVersion", "expectedTrajectory", "maximumLatencyMs"],
  "properties": {
    "schemaVersion": {"const": "dipole.agent.memory-correction-eval-manifest.v1"},
    "candidateVersion": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"},
    "expectedSourceVersion": {"type": "integer", "minimum": 1, "maximum": 4294967294},
    "expectedTrajectory": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/step"}},
    "maximumLatencyMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  },
  "$defs": {
    "step": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$"}
  }
}
