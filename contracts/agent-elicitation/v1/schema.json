{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-elicitation/v1/schema.json",
  "title": "Dipole Agent Elicitation Form v1",
  "description": "Language-neutral restricted form shown while an Agent Task is waiting for authenticated user input.",
  "x-dipole-version": "dipole.agent.elicitation.v1",
  "type": "object",
  "required": ["schemaVersion", "fields"],
  "properties": {
    "schemaVersion": {"const": "dipole.agent.elicitation.v1"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/field"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "label", "type", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "required": {"type": "boolean"}
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "field": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/base"},
            {"properties": {"type": {"const": "text"}, "maxLength": {"type": "integer", "minimum": 1, "maximum": 4000}}}
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {"$ref": "#/$defs/base"},
            {"required": ["options"], "properties": {"type": {"const": "select"}, "options": {"$ref": "#/$defs/options"}}}
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {"$ref": "#/$defs/base"},
            {"required": ["options"], "properties": {"type": {"const": "multiselect"}, "options": {"$ref": "#/$defs/options"}, "maxSelections": {"type": "integer", "minimum": 1, "maximum": 32}}}
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {"$ref": "#/$defs/base"},
            {"properties": {"type": {"const": "boolean"}}}
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
