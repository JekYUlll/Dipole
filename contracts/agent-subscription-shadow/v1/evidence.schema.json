{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-subscription-shadow/v1/evidence.schema.json",
  "title": "Dipole Agent Subscription Shadow Evidence v1",
  "type": "object",
  "x-dipole-version": "dipole.agent.subscription-shadow-evidence.v1",
  "required": ["schema_version", "outcome", "window_start", "window_end", "collected_at", "expires_at", "runtime_revision", "prometheus_config_sha256", "query_revision", "expected_scrapes", "successful_scrapes", "counter_resets", "deltas", "candidate_delta", "observed_events", "production_authority", "runtime_change_authority", "content_sha256"],
  "properties": {
    "schema_version": {"const": "dipole.agent.subscription-shadow-evidence.v1"}, "outcome": {"const": "passed"},
    "window_start": {"type": "string", "format": "date-time"}, "window_end": {"type": "string", "format": "date-time"},
    "collected_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "runtime_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "prometheus_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "query_revision": {"const": "subscription-shadow-v1"}, "expected_scrapes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "successful_scrapes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "counter_resets": {"const": 0},
    "deltas": {"type": "object", "required": ["accepted_match", "accepted_miss", "accepted_error", "ignored_match", "ignored_miss", "ignored_error"], "properties": {"accepted_match": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "accepted_miss": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "accepted_error": {"const": 0}, "ignored_match": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "ignored_miss": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "ignored_error": {"const": 0}}, "additionalProperties": false},
    "candidate_delta": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "observed_events": {"type": "integer", "minimum": 100, "maximum": 9007199254740991},
    "production_authority": {"const": false}, "runtime_change_authority": {"const": false}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
