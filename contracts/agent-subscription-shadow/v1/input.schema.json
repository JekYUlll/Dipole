{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dipole.local/contracts/agent-subscription-shadow/v1/input.schema.json",
  "title": "Dipole Agent Subscription Shadow Prometheus Snapshot Input v1",
  "type": "object",
  "x-dipole-version": "dipole.agent.subscription-shadow-input.v1",
  "required": ["window_start", "window_end", "runtime_revision", "prometheus_config_sha256", "query_revision", "expected_scrapes", "successful_scrapes", "counter_resets", "start", "end"],
  "properties": {
    "window_start": {"type": "string", "format": "date-time"}, "window_end": {"type": "string", "format": "date-time"},
    "runtime_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "prometheus_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "query_revision": {"const": "subscription-shadow-v1"}, "expected_scrapes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "successful_scrapes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "counter_resets": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "start": {"$ref": "#/$defs/counters"}, "end": {"$ref": "#/$defs/counters"}
  },
  "$defs": {"counters": {"type": "object", "required": ["accepted_match", "accepted_miss", "accepted_error", "ignored_match", "ignored_miss", "ignored_error", "candidates"], "properties": {"accepted_match": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "accepted_miss": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "accepted_error": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "ignored_match": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "ignored_miss": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "ignored_error": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "candidates": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "additionalProperties": false}},
  "additionalProperties": false
}
