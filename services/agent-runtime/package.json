{
  "name": "dipole-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "generate:sql": "node ../../scripts/generate-agent-ledger-queries.mjs && node ../../scripts/generate-agent-model-audit-queries.mjs && node ../../scripts/generate-agent-shadow-trajectory-queries.mjs && node ../../scripts/generate-agent-eval-observation-queries.mjs && node ../../scripts/generate-agent-memory-derived-lineage-queries.mjs",
    "generate:proto": "node ../../scripts/generate-agent-proto-ts.mjs",
    "check:proto": "node ../../scripts/check-agent-proto-ts.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.77",
    "@grpc/grpc-js": "1.14.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@protobuf-ts/runtime": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "ai": "7.0.83",
    "fastify": "5.12.1",
    "kafkajs": "2.2.4",
    "mysql2": "3.24.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "2.11.1",
    "@temporalio/testing": "1.23.0",
    "@types/node": "24.10.13",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
