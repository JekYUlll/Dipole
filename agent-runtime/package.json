{
  "name": "dipole-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "generate:sql": "node ../scripts/generate-agent-ledger-queries.mjs && node ../scripts/generate-agent-model-audit-queries.mjs && node ../scripts/generate-agent-shadow-trajectory-queries.mjs",
    "generate:proto": "node ../scripts/generate-agent-proto-ts.mjs",
    "check:proto": "node ../scripts/check-agent-proto-ts.mjs",
    "context:calibrate": "tsx src/context/token-calibration-cli.ts",
    "reconcile:projection": "tsx src/reconcile/projection-reconcile-cli.ts",
    "promotion:check": "tsx src/promotion/promotion-check-cli.ts",
    "repair:propose": "tsx src/promotion/workflow-repair-proposal-cli.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@protobuf-ts/runtime": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "ai": "7.0.83",
    "fastify": "5.12.1",
    "kafkajs": "2.2.4",
    "mysql2": "3.24.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "2.11.1",
    "@temporalio/testing": "1.23.0",
    "@types/node": "24.10.13",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
