{
  "name": "dipole-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "generate:sql": "node ../scripts/generate-agent-ledger-queries.mjs && node ../scripts/generate-agent-model-audit-queries.mjs && node ../scripts/generate-agent-shadow-trajectory-queries.mjs && node ../scripts/generate-agent-eval-observation-queries.mjs",
    "generate:proto": "node ../scripts/generate-agent-proto-ts.mjs",
    "check:proto": "node ../scripts/check-agent-proto-ts.mjs",
    "context:calibrate": "tsx src/context/token-calibration-cli.ts",
    "eval:offline": "tsx src/evals/offline-eval-cli.ts",
    "eval:memory-correction": "tsx src/evals/memory-correction-eval-cli.ts",
    "eval:prefilter": "tsx src/evals/subscription-prefilter-eval-cli.ts",
    "eval:prefilter-review": "tsx src/evals/subscription-corpus-review-cli.ts",
    "eval:subscription-rollout": "tsx src/evals/subscription-rollout-eval-cli.ts",
    "eval:subscription-shadow-collect": "tsx src/evals/subscription-shadow-collector-cli.ts",
    "eval:subscription-shadow-evidence": "tsx src/evals/subscription-shadow-evidence-cli.ts",
    "eval:shadow": "tsx src/evals/shadow-eval-cli.ts",
    "reconcile:projection": "tsx src/reconcile/projection-reconcile-cli.ts",
    "promotion:check": "tsx src/promotion/promotion-check-cli.ts",
    "promotion:publish": "tsx src/promotion/promotion-evidence-publish-cli.ts",
    "mcp:readiness:publish": "tsx src/mcp/external-mcp-readiness-publish-cli.ts",
    "mcp:credential-drill:check": "tsx src/runtime/external-mcp-credential-lifecycle-evidence-cli.ts",
    "mcp:shadow-drill:check": "tsx src/runtime/external-mcp-shadow-drill-evidence-cli.ts",
    "repair:propose": "tsx src/promotion/workflow-repair-proposal-cli.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@protobuf-ts/runtime": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "ai": "7.0.83",
    "fastify": "5.12.1",
    "kafkajs": "2.2.4",
    "mysql2": "3.24.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "2.11.1",
    "@temporalio/testing": "1.23.0",
    "@types/node": "24.10.13",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
